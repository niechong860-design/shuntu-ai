{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-shuntu",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public"
  },
  "vars": {
    "DATABASE_PRIMARY": "d1",
    "R2_PUBLIC_BASE_URL": "https://img.shuntu.cc",
    "REAL_GENERATION_ENABLED": "production",
    "REAL_PAYMENT_ENABLED": "production"
  },
  "r2_buckets": [
    {
      "binding": "SHUNTU_GENERATED_IMAGES",
      "bucket_name": "shuntu-generated-images"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shuntu-prod",
      "database_id": "a475419e-3878-4ede-84d0-75fad8ebd5cd",
      "migrations_dir": "d1/migrations"
    }
  ],
  "containers": [
    {
      "class_name": "SharpImageProcessor",
      "image": "./services/image-processor/Dockerfile",
      "image_build_context": "./services/image-processor",
      "scheduling_policy": "default",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "SharpImageProcessor",
        "name": "SHARP_IMAGE_PROCESSOR"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SharpImageProcessor"]
    }
  ]
}
